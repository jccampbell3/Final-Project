@page
@model Final_Project.Pages.Bosses.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Boss</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Boss.BossId" />
            <div class="form-group">
                <label asp-for="Boss.Name" class="control-label"></label>
                <input asp-for="Boss.Name" class="form-control" />
                <span asp-validation-for="Boss.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boss.Description" class="control-label"></label>
                <input asp-for="Boss.Description" class="form-control" />
                <span asp-validation-for="Boss.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boss.StrengthLevel" class="control-label"></label>
                <input asp-for="Boss.StrengthLevel" class="form-control" />
                <span asp-validation-for="Boss.StrengthLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boss.DefenseLevel" class="control-label"></label>
                <input asp-for="Boss.DefenseLevel" class="form-control" />
                <span asp-validation-for="Boss.DefenseLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boss.SpeedLevel" class="control-label"></label>
                <input asp-for="Boss.SpeedLevel" class="form-control" />
                <span asp-validation-for="Boss.SpeedLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Boss.LootItems" class="control-label"></label>
                <input asp-for="Boss.LootItems" class="form-control" />
                <span asp-validation-for="Boss.LootItems" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
