@page
@model Final_Project.Pages.HighScores.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>HighScore</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="HighScore.HighScoreId" />
            <div class="form-group">
                <label asp-for="HighScore.PlayerId" class="control-label"></label>
                <select asp-for="HighScore.PlayerId" class="form-control" asp-items="ViewBag.PlayerId" ></select>
                <span asp-validation-for="HighScore.PlayerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HighScore.BossId" class="control-label"></label>
                <select asp-for="HighScore.BossId" class="form-control" asp-items="ViewBag.BossId" ></select>
                <span asp-validation-for="HighScore.BossId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HighScore.KillCount" class="control-label"></label>
                <input asp-for="HighScore.KillCount" class="form-control" />
                <span asp-validation-for="HighScore.KillCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
