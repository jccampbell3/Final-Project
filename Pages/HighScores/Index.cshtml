@page
@model Final_Project.Pages.HighScores.IndexModel
@{
    ViewData["Title"] = "High Scores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>High Scores</h2>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Score
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Player</th>
                <th>Boss</th>
                <th>Kill Count</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var score in Model.HighScore) {
                
                <tr>
                    <td>@score.Player.Username</td>
                    <td>@score.Boss.Name</td>
                    <td>@score.KillCount</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@score.HighScoreId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-page="Details" asp-route-id="@score.HighScoreId" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-page="Delete" asp-route-id="@score.HighScoreId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>